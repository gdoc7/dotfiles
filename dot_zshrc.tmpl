# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"


plugins=(
  kind
  ssh-agent
)

source $ZSH/oh-my-zsh.sh

WM_VAR="/$TMUX"
WM_CMD="tmux"

export FZF_DEFAULT_COMMAND="fdfind --hidden --strip-cwd-prefix --exclude .git"
export FZF_DEFAULT_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_COMMAND="fdfind --type=d --hidden --strip-cwd-prefix --exclude .git"

function start_if_needed() {
    if [[ $- == *i* ]] && [[ -z "${WM_VAR#/}" ]] && [[ -t 1 ]]; then
        exec $WM_CMD
    fi
}

export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
source <(carapace _carapace)

. "$HOME/.atuin/bin/env"

# Set up fzf key bindings and fuzzy completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

eval "$(zoxide init zsh)"
eval "$(atuin init zsh)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

start_if_needed

alias cat="batcat"
export LS_COLORS="di=1;34:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"
export ZLS_COLORS="di=34:ln=35:so=32:pi=33:ex=31:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43"

alias ll="lsd -l --header --date relative"  # Listado detallado bonito
alias lt="lsd -a --tree" # Árbol con profundidad controlada
alias k="microk8s kubectl"
# Aliases para lazydocker (ld) y lazygit (lg)
alias ld="lazydocker"
alias lg="lazygit"

# ===== MICROK8S CONTROL =====
alias mkup='microk8s start && microk8s status --wait-ready'  # Levanta el cluster y espera
alias mkdn='microk8s stop'                                   # Detiene el cluster limpiamente
alias mkr='mkdn && mkup'                                     # Reinicio rápido (stop + start)
alias mk='microk8s kubectl'
alias mkp='microk8s kubectl get pods -A'               # Todos los pods
alias mks='microk8s kubectl get services -A'           # Todos los servicios
alias mkn='microk8s kubectl get nodes -o wide'        # Nodos con detalles
alias mka='microk8s kubectl get all -A'                # Todos los recursos

# Path management
export PATH="$HOME/bin:$HOME/.local/bin:/mnt/c/ProgramData/chocolatey/bin:$PATH:/snap/bin:/usr/local/go/bin:$HOME/gems/bin"
export PATH="/home/gabri/.opencode/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# pyenv initialization
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# Busca si existe en chocolatey y si existe lo ejecuta sin colocar .exe 
function command_not_found_handler() {
  if [[ -x "/mnt/c/ProgramData/chocolatey/bin/${1}.exe" ]]; then
    "/mnt/c/ProgramData/chocolatey/bin/${1}.exe" "${@:2}"
  else
    echo "zsh: command not found: $1"
    return 127
  fi
}

