audit_cli() {
    if [ -z "$1" ]; then
        echo "Uso: audit_cli <comando>"
        return 1
    fi
    
    export HTTP_PROXY="http://127.0.0.1:8080"
    export HTTPS_PROXY="http://127.0.0.1:8080"
    export NODE_TLS_REJECT_UNAUTHORIZED=0
    
    eval "$@"
    
    unset HTTP_PROXY
    unset HTTPS_PROXY
    unset NODE_TLS_REJECT_UNAUTHORIZED
}

