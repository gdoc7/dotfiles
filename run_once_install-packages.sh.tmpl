#!/usr/bin/env bash
# chezmoi run_once script - installs all required packages
# Runs only once. Delete ~/.local/share/chezmoi/run_once_install-packages.sh
# in the state to force re-run.

set -euo pipefail

# ─── macOS ──────────────────────────────────────────────────────────────
if [[ "$(uname -s)" == "Darwin" ]]; then
  echo "→ Installing Homebrew..."
  if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)"
  fi

  echo "→ Installing packages with brew..."
  brew install \
    chezmoi \
    gnupg \
    pass \
    neovim \
    fzf \
    fd \
    bat \
    lsd \
    zoxide \
    atuin \
    lazygit \
    lazydocker \
    tmux \
    carapace \
    git \
    zsh \
    ripgrep \
    node \
    go \
    pyenv \
    starship

  echo "→ Installing Oh My Zsh..."
  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  fi

  echo "→ Installing Powerlevel10k..."
  if [[ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
      "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
  fi

  echo "→ macOS packages installed."

# ─── Linux ──────────────────────────────────────────────────────────────
elif [[ "$(uname -s)" == "Linux" ]]; then
  echo "→ Updating apt..."
  sudo apt-get update -qq

  echo "→ Installing packages with apt..."
  sudo apt-get install -y -qq \
    neovim \
    fzf \
    fd-find \
    bat \
    zoxide \
    tmux \
    git \
    zsh \
    ripgrep \
    curl \
    wget \
    gnupg \
    pass \
    build-essential \
    python3 \
    python3-pip

  # chezmoi (install script from official site)
  if ! command -v chezmoi &>/dev/null; then
    echo "→ Installing chezmoi..."
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b /usr/local/bin
  fi

  # lsd (may need manual install)
  if ! command -v lsd &>/dev/null; then
    echo "→ Installing lsd..."
    curl -fsSL https://github.com/lsd-rs/lsd/releases/latest/download/lsd-musl-x86_64-unknown-linux-gnu.tar.gz | \
      tar xz -C /tmp && sudo mv /tmp/lsd-*/lsd /usr/local/bin/lsd 2>/dev/null || \
      echo "→ lsd manual install failed, install via cargo: cargo install lsd"
  fi

  # lazygit
  if ! command -v lazygit &>/dev/null; then
    echo "→ Installing lazygit..."
    LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | \
      grep -Po '"tag_name": *"v\K[^"]*')
    curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
    tar xzf lazygit.tar.gz -C /tmp && sudo mv /tmp/lazygit /usr/local/bin/
    rm -f lazygit.tar.gz
  fi

  # lazydocker
  if ! command -v lazydocker &>/dev/null; then
    echo "→ Installing lazydocker..."
    curl -fsSL https://github.com/jesseduffield/lazydocker/releases/latest/download/lazydocker_Linux_x86_64.tar.gz | \
      tar xz -C /tmp && sudo mv /tmp/lazydocker /usr/local/bin/lazydocker 2>/dev/null || echo "→ lazydocker manual install failed"
  fi

  # atuin
  if ! command -v atuin &>/dev/null; then
    echo "→ Installing atuin..."
    curl --proto '=https' --tlsv1.2 -LsSf https://github.com/atuinsh/atuin/releases/latest/download/atuin-installer.sh | sh
  fi

  # carapace
  if ! command -v carapace &>/dev/null; then
    echo "→ Installing carapace..."
    curl -fsSL https://github.com/carapace-sh/carapace-bin/releases/latest/download/carapace-bin_Linux_x86_64.tar.gz | \
      tar xz -C /tmp && sudo mv /tmp/carapace /usr/local/bin/carapace 2>/dev/null || echo "→ carapace manual install failed"
  fi

  # zoxide
  if ! command -v zoxide &>/dev/null; then
    echo "→ Installing zoxide..."
    curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
  fi

  echo "→ Installing Oh My Zsh..."
  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
  fi

  echo "→ Installing Powerlevel10k..."
  if [[ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
      "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
  fi

  echo "→ Linux packages installed."

else
  echo "! Unsupported OS: $(uname -s)"
  exit 1
fi

echo "✓ All packages installed. Now run: chezmoi apply"
